# ChokePidgin / iSpeakPidgin environment configuration
#
# Replaces the older config/.env.example -- there is one template, and it lives next to
# where .env itself belongs (dotenv reads .env from the repo root).
#
#   cp .env.example .env    then fill in the real values.
#
# .env is gitignored. NEVER commit real keys -- rotate anything that leaks.
#
# Without SUPABASE_URL + a Supabase key, config/supabase.js silently falls back to an
# OFFLINE MOCK client backed by tools/testing/mock-supabase-data.json (88 fixture entries).
# The app and the test suite still run, but every number you see is fixture data. Leaving a
# placeholder value here is worse than leaving the variable unset: a non-empty key defeats the
# mock fallback and every query fails with a 401 instead.

# --- Supabase (required) ---------------------------------------------------------------
# Dashboard -> Project Settings -> API
SUPABASE_URL=https://jfzgzjgdptowfbtljvyp.supabase.co
# "anon / public" key. Safe in browsers and safe as a GitHub Actions secret.
SUPABASE_ANON_KEY=
# "service_role" key. SECRET -- bypasses Row Level Security. Server-side only, never in a
# client bundle. Required for admin endpoints, the suggestion queue and audio pre-generation.
# Both spellings are read; SUPABASE_SERVICE_ROLE_KEY is the more common one in this codebase.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SERVICE_KEY=

# --- AI + speech (required for those features) ------------------------------------------
# https://elevenlabs.io -> Profile -> API Key. Consumes paid credits on every cache miss.
ELEVENLABS_API_KEY=
# https://aistudio.google.com/apikey -- powers /api/ai/talk-story and /api/ai/translate.
GEMINI_API_KEY=

# --- Server ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
SITE_URL=https://chokepidgin.com
# Signing secret for user auth tokens. Use a long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# One-time secret gating first-admin creation. Unset it once an admin exists.
ADMIN_SETUP_SECRET=

# --- Optional: SEO / analytics tooling (tools/seo/*) -------------------------------------
# Paths to Google service-account JSON files; only needed for the SEO and GA scripts.
GOOGLE_SEARCH_CONSOLE_KEY_PATH=
GOOGLE_ANALYTICS_KEY_PATH=
GA4_PROPERTY_ID=
SEARCH_CONSOLE_API_PORT=
